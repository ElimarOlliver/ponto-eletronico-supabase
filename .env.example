# Supabase project settings (Dashboard -> Project Settings -> API)
# Formato legado: SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# Formato novo (2025+): SUPABASE_PUBLISHABLE_KEY (sb_publishable_...) / SUPABASE_SECRET_KEY (sb_secret_...)
# O backend aceita ambos (legado tem prioridade).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Opcional (só p/ tarefas admin: sync de feriados nacionais). Não exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Opcional: rate-limit distribuído (produção multi-instância).
# Sem REDIS_URL, o rate-limit opera em memória (suficiente p/ localhost).
# Ex: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Optional: set to America/Sao_Paulo for formatting in server logs
TZ=America/Sao_Paulo
